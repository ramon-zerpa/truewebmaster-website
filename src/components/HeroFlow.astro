---
import { text, type Locale } from "../lib/routes";
import { heroFlowConfig, type FlowConfig } from "../lib/hero-flow/config";
interface Props {
  locale: Locale;
  config?: Partial<FlowConfig>;
}
const { locale, config = {} } = Astro.props;
const settings = {
  ...heroFlowConfig,
  ...config,
  palette: { ...heroFlowConfig.palette, ...config.palette },
};
---

<div
  class="hero-flow"
  data-hero-flow
  data-flow-config={JSON.stringify(settings)}
  style={`--flow-opacity:${settings.opacity};--flow-blur:${settings.blurAmount}px`}
  aria-hidden="true"
>
  <canvas class="flow-canvas"></canvas>
</div>
<button
  class="flow-toggle"
  type="button"
  data-flow-toggle
  hidden
  data-pause={text(locale, "Pause background", "Pausar fondo")}
  data-play={text(locale, "Play background", "Activar fondo")}
  aria-pressed="false"
>
  {text(locale, "Pause background", "Pausar fondo")}
</button>
<style>
  .hero-flow {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: #111a27 url("/images/hero-flow-poster.webp") center / cover
      no-repeat;
  }
  .flow-canvas {
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    filter: blur(var(--flow-blur));
    transition: opacity 0.65s ease;
  }
  .hero-flow[data-ready] .flow-canvas {
    opacity: var(--flow-opacity);
  }
  .flow-toggle {
    position: absolute;
    right: max(40px, calc((100vw - var(--max)) / 2));
    bottom: 15px;
    min-height: 44px;
    padding: 8px 13px;
    border: 1px solid #7394a6;
    border-radius: 3px;
    background: #111a27cc;
    color: #d3e8ee;
    font-size: 0.75rem;
  }
  .flow-toggle:hover {
    background: var(--night);
    color: white;
  }
  @media (max-width: 767px) {
    :global(.hero) {
      padding-bottom: 64px;
    }
    .flow-toggle {
      right: 20px;
      bottom: 6px;
    }
    .hero-flow {
      background-position: 65% center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow-toggle {
      display: none;
    }
    .flow-canvas {
      transition: none;
    }
  }
</style>
<script>
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  document.querySelectorAll<HTMLElement>("[data-hero-flow]").forEach((root) => {
    let started = false;
    const start = () => {
      if (reduced.matches || started) return;
      started = true;
      import("../lib/hero-flow/renderer")
        .then(({ mountHeroFlow }) => mountHeroFlow(root))
        .catch(() => {
          started = false;
        });
    };
    reduced.addEventListener("change", start);
    if ("requestIdleCallback" in window)
      window.requestIdleCallback(start, { timeout: 1500 });
    else setTimeout(start, 200);
  });
</script>
