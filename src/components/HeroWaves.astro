---
import { text, type Locale } from "../lib/routes";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const gradient = `hero-wave-stroke-${locale}`;
---

<div class="hero-waves" data-hero-waves aria-hidden="true">
  <svg viewBox="0 0 1440 800" fill="none" preserveAspectRatio="xMidYMin slice">
    <defs>
      <linearGradient
        id={gradient}
        x1="220"
        y1="300"
        x2="1430"
        y2="180"
        gradientUnits="userSpaceOnUse"
      >
        <stop stop-color="#17A2B8" stop-opacity="0" />
        <stop offset=".5" stop-color="#17A2B8" stop-opacity=".55" />
        <stop offset="1" stop-color="#A8DDE3" stop-opacity=".8" />
      </linearGradient>
    </defs>
    <g
      class="wave-layer wave-layer-near"
      stroke={`url(#${gradient})`}
      stroke-width="1.4"
    >
      {[0, 25, 50, 75, 100].map((offset) => (
        <path
          d={`M160 ${270 + offset} C390 ${70 + offset} 570 ${460 + offset} 810 ${280 + offset} S1090 ${275 + offset} 1200 ${175 + offset} S1400 ${120 + offset} 1580 ${240 + offset}`}
        />
      ))}
    </g>
    <g
      class="wave-layer wave-layer-far"
      stroke={`url(#${gradient})`}
      stroke-width="1"
      opacity=".45"
    >
      {[0, 30, 60, 90].map((offset) => (
        <path
          d={`M110 ${425 + offset} C420 ${200 + offset} 590 ${610 + offset} 890 ${410 + offset} S1180 ${340 + offset} 1390 ${385 + offset} S1530 ${425 + offset} 1650 ${305 + offset}`}
        />
      ))}
    </g>
  </svg>
</div>
<button
  class="wave-toggle"
  type="button"
  data-wave-toggle
  hidden
  data-pause={text(locale, "Pause waves", "Pausar ondas")}
  data-play={text(locale, "Play waves", "Activar ondas")}
  aria-pressed="false"
>
  {text(locale, "Pause waves", "Pausar ondas")}
</button>

<style>
  .hero-waves {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: -1;
    pointer-events: none;
    opacity: 0.65;
  }
  .hero-waves svg {
    width: 100%;
    height: 100%;
  }
  .wave-layer {
    transform-origin: 75% 40%;
    animation: wave-drift-near 16s ease-in-out infinite alternate;
    animation-play-state: paused;
  }
  .wave-layer-far {
    animation-name: wave-drift-far;
    animation-duration: 23s;
  }
  .hero-waves[data-running] .wave-layer {
    animation-play-state: running;
    will-change: transform;
  }
  @keyframes wave-drift-near {
    from {
      transform: translate3d(2%, -3%, 0) rotate(-3deg) scale(1.03);
      opacity: 0.65;
    }
    to {
      transform: translate3d(-5%, 6%, 0) rotate(3deg) scale(1.1);
      opacity: 1;
    }
  }
  @keyframes wave-drift-far {
    from {
      transform: translate3d(-4%, 5%, 0) rotate(2deg) scale(1.08);
    }
    to {
      transform: translate3d(5%, -5%, 0) rotate(-4deg) scale(1.02);
    }
  }
  .wave-toggle {
    position: absolute;
    right: max(40px, calc((100vw - var(--max)) / 2));
    bottom: 15px;
    min-height: 44px;
    padding: 8px 13px;
    border: 1px solid #7394a6;
    border-radius: 3px;
    background: #111a27cc;
    color: #d3e8ee;
    font-size: 0.75rem;
  }
  .wave-toggle:hover {
    background: var(--night);
    color: white;
  }
  @media (max-width: 767px) {
    :global(.hero) {
      padding-bottom: 64px;
    }
    .hero-waves {
      opacity: 0.35;
    }
    .hero-waves svg {
      width: 180%;
      max-width: none;
      margin-left: -65%;
    }
    .wave-toggle {
      right: 20px;
      bottom: 6px;
      min-height: 44px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wave-layer {
      animation: none;
    }
    .wave-toggle {
      display: none;
    }
  }
</style>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-hero-waves]")
    .forEach((waves) => {
      const button =
        waves.parentElement!.querySelector<HTMLButtonElement>(
          "[data-wave-toggle]",
        )!;
      const reduced = matchMedia("(prefers-reduced-motion: reduce)");
      let paused = false;
      let visible = true;
      const update = () => {
        waves.toggleAttribute(
          "data-running",
          !paused && visible && !document.hidden && !reduced.matches,
        );
        button.hidden = reduced.matches;
        button.setAttribute("aria-pressed", String(paused));
        button.textContent = paused
          ? button.dataset.play!
          : button.dataset.pause!;
      };
      button.addEventListener("click", () => {
        paused = !paused;
        update();
      });
      reduced.addEventListener("change", update);
      document.addEventListener("visibilitychange", update);
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        update();
      }).observe(waves.parentElement!);
      update();
    });
</script>
