---
import { heroHeadlineConfig } from "../lib/hero-headline/config";
interface Props {
  first: string;
  second: string;
}
const { first, second } = Astro.props;
---

<h1
  data-hero-headline
  data-headline-config={JSON.stringify(heroHeadlineConfig)}
>
  <span data-headline-source>
    {first} <br />
    {second}
  </span>
</h1>
<script is:inline>
  (() => {
    const h = document.querySelector("[data-hero-headline]");
    if (
      !h ||
      matchMedia("(prefers-reduced-motion: reduce)").matches ||
      document.hidden
    )
      return;
    h.setAttribute("data-reveal-pending", "");
    const c = JSON.parse(h.getAttribute("data-headline-config"));
    setTimeout(
      () => h.removeAttribute("data-reveal-pending"),
      c.lateStartLimitMs,
    );
  })();
</script>
<style>
  h1 {
    position: relative;
  }
  h1[data-revealing] > [data-headline-source],
  h1[data-reveal-pending] > [data-headline-source] {
    opacity: 0;
  }
</style>
<script>
  import { revealHeroHeadline } from "../lib/hero-headline/reveal";
  document
    .querySelectorAll<HTMLElement>("[data-hero-headline]")
    .forEach(revealHeroHeadline);
</script>
